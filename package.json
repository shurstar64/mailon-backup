{
  "name": "mailon-llm-wiki",
  "version": "1.0.0",
  "description": "MailON to LLM Wiki integration layer",
  "private": true,
  "scripts": {
    "check": "python -m scripts.check_mail_sync",
    "check:json": "python -m scripts.check_mail_sync --json",
    "check:verbose": "python -m scripts.check_mail_sync --verbose",

    "ingest": "python -m scripts.ingest_mail",
    "ingest:dry": "python -m scripts.ingest_mail --dry-run",
    "ingest:force": "python -m scripts.ingest_mail --force",
    "ingest:verbose": "python -m scripts.ingest_mail --verbose",

    "extract": "python -m scripts.extract_entities",
    "extract:dry": "python -m scripts.extract_entities --dry-run",
    "extract:people": "python -m scripts.extract_entities --type people",
    "extract:projects": "python -m scripts.extract_entities --type projects",
    "extract:meetings": "python -m scripts.extract_entities --type meetings",

    "search": "python -m scripts.search_mail",
    "search:json": "python -m scripts.search_mail --json",

    "brief": "python -m scripts.daily_brief",
    "brief:dry": "python -m scripts.daily_brief --dry-run",
    "brief:week": "python -m scripts.daily_brief --days 7",
    "brief:json": "python -m scripts.daily_brief --json",

    "hook:post-sync": "python -m hooks.post_sync",
    "hook:post-sync:force": "python -m hooks.post_sync --force",
    "hook:post-sync:dry": "python -m hooks.post_sync --dry-run",
    "hook:post-sync:wiki": "python -m hooks.post_sync --force --sync-wiki",

    "wiki:sync": "python -m scripts.sync_to_wiki",
    "wiki:sync:dry": "python -m scripts.sync_to_wiki --dry-run",
    "wiki:sync:full": "python -m scripts.sync_to_wiki --full-mirror",
    "wiki:sync:all": "python -m scripts.sync_to_wiki --include-entities",

    "watch": "python -m scripts.watch_mails",
    "watch:wiki": "python -m scripts.watch_mails --sync-wiki",
    "watch:daemon": "python -m scripts.watch_mails --daemon",

    "backend:status": "python -m adapters.mailon_backend status",
    "backend:list": "python -m adapters.mailon_backend list",
    "backend:search": "python -m adapters.mailon_backend search --query",

    "test": "python -m pytest tests/ -v",
    "test:coverage": "python -m pytest tests/ -v --cov=scripts --cov=hooks --cov=adapters --cov-report=term-missing",
    "test:watch": "python -m pytest tests/ -v --watch",

    "pipeline": "npm run ingest && npm run extract && npm run brief",
    "pipeline:dry": "npm run ingest:dry && npm run extract:dry && npm run brief:dry",
    "pipeline:wiki": "npm run ingest && npm run extract && npm run wiki:sync",
    "pipeline:full": "npm run ingest && npm run extract && npm run brief && npm run wiki:sync:all",

    "sync": "python -m mailon.main sync",
    "sync:status": "python -m mailon.main status"
  },
  "keywords": ["mailon", "llm", "wiki", "email", "backup"],
  "author": "",
  "license": "MIT"
}
