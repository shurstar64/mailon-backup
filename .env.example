# mailon.kr credentials - DO NOT COMMIT THIS FILE
# Copy to .env and fill in your actual values

# Your mailon.kr email address (full address including @mailon.kr or domain)
MAILON_ID=your_id@mailon.kr

# Your mailon.kr password
MAILON_PW=your_password_here

# TOTP Base32 secret from Google OTP registration
# When you register Google OTP on mailon.kr, scan the QR with Google Authenticator
# AND record the Base32 secret string shown on the page (e.g. JBSWY3DPEHPK3PXP)
# Keep THAT secret here. This lets this script generate the same 6-digit code
# as your phone, in parallel, without disturbing the phone registration.
MAILON_TOTP_SECRET=YOUR_BASE32_TOTP_SECRET_HERE

# Optional: Run headless (true) or with visible browser (false, for debugging)
HEADLESS=true

# Optional: Maximum mails to fetch per run (0 = unlimited, for initial backup)
MAX_MAILS_PER_RUN=0

# Optional: Login URL (default should be fine)
MAILON_LOGIN_URL=https://mailon.kr/

# 선택. `agent-browser` 실행 파일 경로를 직접 지정할 때 사용.
# 미지정 시 PATH에서 탐색. (`mailon/browser.py`가 읽음)
# AGENT_BROWSER_BIN=
